{
  "id": "01a06478-f4f4-725a-8bc0-776641f7a436",
  "name": "Transit Thing",
  "version": "0.1.0",
  "description": "Next arrivals for your stops, from a Transit Tracker server (tt.horner.tj by default). Reads this device's location only when you ask for nearby stops, and sends a rounded area around you to that server.",
  "icon": "icon.svg",
  "settings": "settings.html",
  "config": [
    {
      "type": "string",
      "data": {
        "key": "apiBaseUrl",
        "label": "Transit Tracker API base URL",
        "pattern": "^https://[A-Za-z0-9.-]+(:[0-9]+)?/?$",
        "minLength": null,
        "maxLength": null,
        "default": "https://tt.horner.tj/"
      }
    },
    {
      "type": "string",
      "data": {
        "key": "feed",
        "label": "Feed code (st is Puget Sound)",
        "pattern": "^[a-z0-9_-]{1,32}$",
        "minLength": null,
        "maxLength": null,
        "default": "st"
      }
    },
    {
      "type": "string",
      "data": {
        "key": "slots",
        "label": "Stops as JSON: [{stopId, stopName, routeIds}] (blank uses the stops picked on the device)",
        "pattern": null,
        "minLength": null,
        "maxLength": 4000,
        "default": ""
      }
    },
    {
      "type": "number",
      "data": {
        "key": "perStop",
        "label": "Arrivals shown per stop",
        "min": 1,
        "max": 4,
        "step": 1,
        "default": 3
      }
    },
    {
      "type": "boolean",
      "data": {
        "key": "ambientIdle",
        "label": "Show the clock after a minute without input",
        "default": true
      }
    }
  ],
  "permissions": [
    "geo",
    "net.fetch",
    "net.ws"
  ],
  "art": {
    "heroPx": 248,
    "thumbPx": 96
  }
}
